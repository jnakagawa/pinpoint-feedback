{
  "manifest_version": 3,
  "name": "Pinpoint — Visual Website Feedback",
  "version": "0.6.0",
  "description": "Drop contextual website feedback and share collaborative review links powered by Zero Auth.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.zero.xyz/*",
    "https://deploy-9po6nd1t-nlbndjpuja-uc.a.run.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Pinpoint",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css", "content-access.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
